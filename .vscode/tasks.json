{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend-install",
      "type": "shell",
      "command": "pnpm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "reveal": "silent", "panel": "shared", "group": "build" },
      "problemMatcher": []
    },
    {
      "label": "frontend-dev",
      "type": "shell",
      "command": "pnpm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "dependsOn": ["frontend-install"],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "dev" },
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": { "activeOnStart": true, "beginsPattern": "VITE", "endsPattern": "Local:" }
      }
    },
    {
      "label": "worker-dev",
      "type": "shell",
      "command": "npx wrangler dev",
      "options": { "cwd": "${workspaceFolder}/worker" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "dev" },
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": { "activeOnStart": true, "beginsPattern": ".", "endsPattern": "Ready on http" }
      }
    },
    {
      "label": "site+worker",
      "dependsOn": ["worker-dev", "frontend-dev"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "overlay-install",
      "type": "shell",
      "command": "pnpm install",
      "options": { "cwd": "${workspaceFolder}/overlay" },
      "presentation": { "reveal": "silent", "panel": "shared", "group": "build" },
      "problemMatcher": []
    },
    {
      "label": "overlay-free-port",
      "type": "shell",
      "command": "powershell -NoProfile -Command \"try { Get-NetTCPConnection -LocalPort 5174 -State Listen -ErrorAction Stop | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue } } catch {}; exit 0\"",
      "presentation": { "reveal": "silent", "panel": "shared", "group": "dev" },
      "problemMatcher": []
    },
    {
      "label": "overlay-ui",
      "type": "shell",
      "command": "pnpm run dev",
      "options": { "cwd": "${workspaceFolder}/overlay" },
      "isBackground": true,
      "dependsOn": ["overlay-install"],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "dev" },
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": { "activeOnStart": true, "beginsPattern": "VITE", "endsPattern": "Local:" }
      }
    },
    {
      "label": "overlay-build",
      "type": "shell",
      "command": "cargo build",
      "options": { "cwd": "${workspaceFolder}/overlay/src-tauri" },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "dev" },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "overlay-prep",
      "dependsOn": ["overlay-ui", "overlay-build"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "overlay-dev (no Rust debugger)",
      "type": "shell",
      "command": "pnpm run app",
      "options": { "cwd": "${workspaceFolder}/overlay" },
      "dependsOn": ["overlay-install"],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "dev" },
      "problemMatcher": []
    }
  ]
}
