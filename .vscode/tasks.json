{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-wasm",
      "type": "shell",
      "command": "go build -v -o frontend/static/calculator.wasm ./wasm",
      "options": {
        "env": {
          "GOOS": "js",
          "GOARCH": "wasm"
        }
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "build"
      },
      "problemMatcher": "$go"
    },
    {
      "label": "frontend-install",
      "type": "shell",
      "command": "pnpm install",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "group": "build"
      },
      "problemMatcher": []
    },
    {
      "label": "frontend-dev",
      "type": "shell",
      "command": "pnpm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "dependsOn": ["build-wasm", "frontend-install"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    }
  ]
}
