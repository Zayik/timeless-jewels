{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoE2 Jewel Overlay",
  "version": "0.1.0",
  "identifier": "com.timeless-jewels.poe2-overlay",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PoE2 Jewel Overlay",
        "x": 0,
        "y": 0,
        "width": 2560,
        "height": 1440,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "timeless-jewels",
    "category": "Utility",
    "shortDescription": "PoE2 timeless-jewel capture overlay",
    "longDescription": "A desktop overlay that helps contributors record what a socketed PoE2 timeless jewel transforms nearby passive nodes into, for submission to the community database.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
